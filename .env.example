# Postgres (Neon). `vercel env pull .env.local` fills these in for a linked project.
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""
# Private Vercel Blob store for uploads and recordings. Leave empty to store files in ./storage.
BLOB_READ_WRITE_TOKEN=""
AUTH_SECRET="replace-with-a-long-random-string"
APP_URL="http://localhost:3000"
# Optional: LLM analysis via Vercel AI Gateway (falls back to rule-based analysis)
AI_GATEWAY_API_KEY=""
ANALYSIS_MODEL="anthropic/claude-sonnet-5.5"
# Optional: real Stripe Checkout (otherwise a dev checkout simulates payments)
STRIPE_SECRET_KEY=""
# Optional: protects /api/cron/auto-accept
CRON_SECRET=""
